  <formulas>
    <formula id="mse">
      <name>MSE</name>
      <latex>MSE = \frac{1}{n} \sum_{i=1}^{n} (y_i - \hat{y}_i)^2</latex>
      <plain>MSE = (1/n) · Σ(yᵢ − ŷᵢ)²</plain>
      <used_in>loss</used_in>
    </formula>
    <formula id="mae">
      <name>MAE</name>
      <latex>MAE = \frac{1}{n} \sum_{i=1}^{n} |y_i - \hat{y}_i|</latex>
      <plain>MAE = (1/n) · Σ|yᵢ − ŷᵢ|</plain>
      <used_in>metric</used_in>
    </formula>
    <formula id="rmse">
      <name>RMSE</name>
      <latex>RMSE = \sqrt{\frac{1}{n} \sum_{i=1}^{n} (y_i - \hat{y}_i)^2}</latex>
      <plain>RMSE = sqrt(MSE)</plain>
      <used_in>metric</used_in>
    </formula>
    <formula id="r2">
      <name>R²</name>
      <latex>R^2 = 1 - \frac{\sum_{i=1}^{n} (y_i - \hat{y}_i)^2}{\sum_{i=1}^{n} (y_i - \bar{y})^2}</latex>
      <plain>R² = 1 − SS_res / SS_tot</plain>
      <used_in>metric</used_in>
    </formula>
    <formula id="rul_frac">
      <name>RUL_frac</name>
      <latex>RUL\_frac = \frac{RUL\_cycles}{total\_cycles}</latex>
      <plain>RUL_frac = RUL_cycles / total_cycles</plain>
      <used_in>target</used_in>
    </formula>
    <formula id="capacity_ratio">
      <name>capacity_ratio</name>
      <latex>capacity\_ratio = \frac{capacity}{cap0}</latex>
      <plain>capacity_ratio = capacity / cap0</plain>
      <used_in>feature</used_in>
    </formula>
    <formula id="voltage_mean">
      <name>voltage_mean</name>
      <latex>\mathrm{voltage\_mean} = \frac{1}{N}\sum_{j=1}^{N} Voltage\_measured_j</latex>
      <plain>voltage_mean = mean(Voltage_measured)</plain>
      <used_in>feature</used_in>
    </formula>
    <formula id="voltage_diff">
      <name>voltage_diff</name>
      <latex>\mathrm{voltage\_diff} = voltage\_mean - voltage\_mean\_lag1</latex>
      <plain>voltage_diff = voltage_mean − voltage_mean_lag1</plain>
      <used_in>feature</used_in>
    </formula>
    <formula id="capacity_diff">
      <name>capacity_diff</name>
      <latex>\mathrm{capacity\_diff} = capacity - capacity\_lag1</latex>
      <plain>capacity_diff = capacity − capacity_lag1</plain>
      <used_in>feature</used_in>
    </formula>
    <formula id="capacity_slope">
      <name>capacity_slope</name>
      <latex>\mathrm{capacity\_slope} = capacity\_diff\_lag1</latex>
      <plain>capacity_slope = capacity_diff предыдущего шага</plain>
      <used_in>feature</used_in>
    </formula>
    <formula id="discharge_rate">
      <name>discharge_rate</name>
      <latex>\mathrm{discharge\_rate} = \frac{capacity}{duration\_discharge}</latex>
      <plain>discharge_rate = capacity / duration_discharge</plain>
      <used_in>feature</used_in>
    </formula>
    <formula id="mae_cycles">
      <name>MAE_cycles</name>
      <latex>MAE\_cycles = MAE\_frac \times \overline{total\_cycles}_{test}</latex>
      <plain>MAE_cycles = MAE_frac × среднее total_cycles теста</plain>
      <used_in>metric</used_in>
    </formula>
    <formula id="standard_scaler">
      <name>StandardScaler</name>
      <latex>z = \frac{x - \mu_{train}}{\sigma_{train}}</latex>
      <plain>z = (x − mean_train) / std_train</plain>
      <used_in>preprocessing</used_in>
    </formula>
  </formulas>

  <processes>
    <process id="parsing">
      <name>Парсинг .mat</name>
      <description>Чтение .mat через scipy.io.loadmat(simplify_cells=True), извлечение зарядных/разрядных циклов, агрегация статистик по discharge-циклу.</description>
      <inputs><input>data/raw/*.mat</input></inputs>
      <outputs><output>data/processed/raw_cycles.parquet</output></outputs>
      <steps>
        <step>1. Открыть .mat, найти поле cycle</step>
        <step>2. Для каждого цикла извлечь type (charge/discharge/impedance)</step>
        <step>3. Для discharge посчитать статистики (mean/min/max/std) по Voltage, Current, Temperature</step>
        <step>4. Собрать единую таблицу: идентификатор батареи, номер цикла, дата, статистики цикла</step>
        <step>5. Сохранить raw_cycles.parquet</step>
      </steps>
      <refs><ref>src/parser.py</ref></refs>
    </process>
    <process id="cleaning">
      <name>Чистка</name>
      <description>Удаление физически невозможных значений и выбросов; отметка низкой ёмкости (EOL).</description>
      <rules>
        <rule>capacity ∉ [0, 2.6] → NaN</rule>
        <rule>voltage &lt; 0 → NaN</rule>
        <rule>re, rct ∉ [0, 1] → NaN (MAD-правило k=5)</rule>
        <rule>первые 3 цикла (формирование) — SKIP_FORMATION</rule>
        <rule>cap &lt; 0.5·cap0 → is_low_capacity=True (EOL)</rule>
      </rules>
      <refs><ref>src/clean.py</ref></refs>
    </process>
    <process id="feature_engineering">
      <name>Построение признаков</name>
      <description>Производные признаки: лаги (shift +k), разности, нормировки, скорость разряда.</description>
      <features>
        <feature>voltage_mean_lag1/lag2</feature>
        <feature>capacity_lag1/lag2/lag3</feature>
        <feature>voltage_diff</feature>
        <feature>capacity_diff</feature>
        <feature>capacity_slope</feature>
        <feature>discharge_rate</feature>
        <feature>capacity_ratio (нормировка на cap0)</feature>
      </features>
      <refs><ref>src/features.py</ref></refs>
    </process>
    <process id="tasks">
      <name>Постановка задач</name>
      <description>Три регрессионные задачи на основе battery_features.parquet.</description>
      <outputs>
        <output>battery_rul.parquet — цель rul_frac (8 батарей)</output>
        <output>battery_voltage.parquet — цель voltage_mean_next (34 батареи)</output>
        <output>battery_capacity.parquet — цель capacity_next (33 батареи)</output>
      </outputs>
      <refs><ref>src/rul.py</ref></refs>
    </process>
    <process id="split">
      <name>Разделение данных</name>
      <description>GroupShuffleSplit по battery_id: батарея принадлежит ровно одной части. Preprocessing (imputer, scaler) обучается только на train.</description>
      <hyperparams>
        <param name="test_size">0.25</param>
        <param name="random_state">42</param>
        <param name="group">battery_id</param>
      </hyperparams>
      <refs><ref>src/split.py</ref></refs>
    </process>
    <process id="training">
      <name>Обучение MLP</name>
      <description>Три независимых MLP для трёх задач; ранняя остановка по val MAE с восстановлением лучших весов.</description>
      <hyperparams>
        <param name="architecture">Dense(64) → Dropout(0.2) → Dense(32) → Dense(1)</param>
        <param name="loss">MSE</param>
        <param name="metric">MAE</param>
        <param name="optimizer">Adam(1e-3)</param>
        <param name="batch_size">32</param>
        <param name="epochs">≤ 200</param>
        <param name="early_stopping">patience=10</param>
        <param name="seed">42</param>
      </hyperparams>
      <refs><ref>src/model.py</ref></refs>
    </process>
    <process id="evaluation">
      <name>Оценка</name>
      <description>MAE/RMSE/R² на test, per-battery MAE, MAE_cycles для RUL.</description>
      <refs><ref>src/export.py</ref></refs>
    </process>
    <process id="baselines">
      <name>Сравнение с базовыми предсказателями</name>
      <description>Константа (среднее train), LinearRegression (imputer+scaler fit на train), RandomForest(100, rs=42); оценка MAE/RMSE/R² на тесте, сравнение с MLP.</description>
      <refs><ref>src/baselines.py</ref></refs>
      <refs><ref>scripts/run_baselines.py</ref></refs>
      <refs><ref>scripts/run_baseline_chart.py</ref></refs>
    </process>
  </processes>

