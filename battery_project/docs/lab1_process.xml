    </entity>
    <entity type="feature">
      <name>voltage_mean</name>
      <formula>mean(Voltage_measured)</formula>
      <unit>V</unit>
      <source>Voltage_measured</source>
    </entity>
    <entity type="feature">
      <name>voltage_min</name>
      <formula>min(Voltage_measured)</formula>
      <unit>V</unit>
      <source>Voltage_measured</source>
    </entity>
    <entity type="feature">
      <name>voltage_max</name>
      <formula>max(Voltage_measured)</formula>
      <unit>V</unit>
      <source>Voltage_measured</source>
    </entity>
    <entity type="feature">
      <name>voltage_std</name>
      <formula>std(Voltage_measured)</formula>
      <unit>V</unit>
      <source>Voltage_measured</source>
    </entity>
    <entity type="feature">
      <name>current_mean</name>
      <formula>mean(Current_measured)</formula>
      <unit>А</unit>
      <source>Current_measured</source>
    </entity>
    <entity type="feature">
      <name>temp_mean</name>
      <formula>mean(Temperature_measured)</formula>
      <unit>°C</unit>
      <source>Temperature_measured</source>
    </entity>
    <entity type="feature">
      <name>temp_min</name>
      <formula>min(Temperature_measured)</formula>
      <unit>°C</unit>
      <source>Temperature_measured</source>
    </entity>
    <entity type="feature">
      <name>temp_max</name>
      <formula>max(Temperature_measured)</formula>
      <unit>°C</unit>
      <source>Temperature_measured</source>
    </entity>
    <entity type="feature">
      <name>temp_range</name>
      <formula>temp_max - temp_min</formula>
      <unit>°C</unit>
      <source>Temperature_measured</source>
    </entity>
    <entity type="feature">
      <name>time_total</name>
      <formula>длительность разряда</formula>
      <unit>с</unit>
      <source>Time</source>
    </entity>
    <entity type="feature">
      <name>voltage_range</name>
      <formula>voltage_max - voltage_min</formula>
      <unit>V</unit>
      <source>Voltage_measured</source>
    </entity>
    <entity type="feature">
      <name>discharge_rate</name>
      <formula>capacity / duration_discharge</formula>
      <unit>Ahr/c</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>capacity</name>
      <formula>ёмкость разрядного цикла</formula>
      <unit>Ahr</unit>
      <source>Capacity</source>
    </entity>
    <entity type="feature">
      <name>capacity_ratio</name>
      <formula>capacity / cap0</formula>
      <unit>доли</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>voltage_mean_lag1</name>
      <formula>voltage_mean.shift(+1)</formula>
      <unit>V</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>voltage_mean_lag2</name>
      <formula>voltage_mean.shift(+2)</formula>
      <unit>V</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>capacity_lag1</name>
      <formula>capacity.shift(+1)</formula>
      <unit>Ahr</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>capacity_lag2</name>
      <formula>capacity.shift(+2)</formula>
      <unit>Ahr</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>capacity_lag3</name>
      <formula>capacity.shift(+3)</formula>
      <unit>Ahr</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>voltage_diff</name>
      <formula>voltage_mean - voltage_mean_lag1</formula>
      <unit>V</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>capacity_diff</name>
      <formula>capacity - capacity_lag1</formula>
      <unit>Ahr</unit>
      <source>производное</source>
    </entity>
    <entity type="feature">
      <name>capacity_slope</name>
      <formula>capacity_diff_lag1</formula>
      <unit>Ahr</unit>
      <source>производное</source>
    </entity>
    <entity type="target">
      <name>rul_frac</name>
      <unit>доли (0–1)</unit>
      <formula>rul_cycles / total_cycles</formula>
    </entity>
    <entity type="target">
      <name>voltage_mean_next</name>
      <unit>В</unit>
      <formula>voltage_mean.shift(-1) следующего цикла</formula>
    </entity>
    <entity type="target">
      <name>capacity_next</name>
      <unit>Ahr</unit>
      <formula>capacity.shift(-1) следующего цикла</formula>
    </entity>
    <entity type="model">
      <name>model_rul</name>
      <architecture>Dense(64) → Dropout(0.2) → Dense(32) → Dense(1)</architecture>
      <params>3073</params>
      <loss>MSE</loss>
      <metric>MAE</metric>
    </entity>
    <entity type="model">
      <name>model_voltage</name>
      <architecture>Dense(64) → Dropout(0.2) → Dense(32) → Dense(1)</architecture>
      <params>3009</params>
      <loss>MSE</loss>
      <metric>MAE</metric>
    </entity>
    <entity type="model">
      <name>model_capacity</name>
      <architecture>Dense(64) → Dropout(0.2) → Dense(32) → Dense(1)</architecture>
      <params>2817</params>
      <loss>MSE</loss>
      <metric>MAE</metric>
    </entity>
  </entities>

